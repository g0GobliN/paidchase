SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Server only
# SUPABASE_SERVICE_ROLE_KEY=
# RESEND_API_KEY=
# EMAIL_FROM=PaidChase <reminders@yourdomain.com>

# Private secret for the reminder worker endpoint. Generate with:
#   openssl rand -hex 32
# Must NEVER be prefixed with VITE_ — anything VITE_-prefixed is compiled into
# the browser bundle and would make the worker publicly callable.
# WORKER_SECRET=
